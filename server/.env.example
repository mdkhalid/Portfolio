# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/portfolio

# JWT — REQUIRED, minimum 32 characters, never use this placeholder.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate_a_random_secret_that_is_at_least_32_chars_long
# Optional: previous JWT secret during rotation (set only when rotating)
JWT_SECRET_PREVIOUS=

# Client origin(s) allowed by CORS, comma-separated (e.g. https://example.com)
CLIENT_URL=http://localhost:5173

# OpenAI API (paid, used when the admin profile's aiProvider is set to 'openai')
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Groq API (free, used when the admin profile's aiProvider is set to 'groq')
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Email (optional — contact form notifications)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Server port (default: 5000)
PORT=5000

# Analytics salt for IP hashing (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ANALYTICS_SALT=

# Trust proxy hops (1 for a direct reverse proxy). NOTE: the server coerces falsy values to 1,
# so setting 0 does not disable it — it becomes 1.
TRUST_PROXY=1
