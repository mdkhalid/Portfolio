# =============================================================================
# Portfolio — Environment Variables
# Copy this file to .env and fill in the required values.
#   cp .env.example .env
# =============================================================================

# ─── Required ────────────────────────────────────────────────────────────────

# MongoDB connection string (e.g. mongodb://localhost:27017/portfolio)
MONGODB_URI=mongodb://localhost:27017/portfolio

# JWT secret used to sign admin auth tokens (minimum 32 characters, use a
# strong random value — run `openssl rand -base64 48` to generate one)
JWT_SECRET=change_me_to_a_random_32_character_string

# Admin JWT lifetime (default: 12h). Examples: 15m, 1h, 12h, 7d.
# Keep short — tokens are invalidated on password change via tokenVersion.
JWT_EXPIRES_IN=12h

# ─── Server ──────────────────────────────────────────────────────────────────

# Port the server listens on (default: 5000)
PORT=5000

# Node environment (development | production | test)
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────

# Allowed client origin(s). Comma-separated if multiple.
# In development this is typically http://localhost:5173 (Vite default).
# When empty, the server's built-in CORS middleware allows common patterns.
CLIENT_URL=http://localhost:5173

# Number of reverse-proxy hops to trust for correct IP detection.
# Set to 0 if running directly without a proxy (default: 1).
TRUST_PROXY=1

# ─── AI Providers (at least one required for Chat & ATS features) ────────────

# OpenAI API key (for GPT-4o Mini chat / ATS scoring)
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq API key (free alternative for Llama 3.3 70B chat / ATS scoring)
# Get yours at https://console.groq.com/keys
GROQ_API_KEY=

# ─── Email (optional — for contact form notifications) ───────────────────────

# SMTP credentials (currently used for contact form email forwarding)
EMAIL_USER=
EMAIL_PASS=

# ─── Analytics (optional) ────────────────────────────────────────────────────

# Salt used to hash visitor IPs for unique-visitor counting.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_SALT=

# Minimum interval (ms) between messages from the same email address.
# Set to 0 to disable. Default: 60000 (1 minute)
CONTACT_MIN_INTERVAL_MS=60000

# ─── Job Automation (optional — Phase 0 foundations) ─────────────────────────

# Redis connection string used by the async apply queue (Bull).
# Leave empty to fall back to an in-memory queue (dev only — not persisted).
# Example: redis://127.0.0.1:6379
REDIS_URL=

# AES-256-GCM encryption key for stored job-site credentials (>= 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOB_CREDENTIALS_KEY=

# Cron schedule for the scheduled job-fetch refresh (default: daily 9:00 AM).
JOB_FETCH_SCHEDULE=0 9 * * *

# Days before a fetched job is considered stale/expired (default: 7).
JOB_STALE_DAYS=7

# Per-user AI generation budget caps (defaults; overridable per user).
JOB_AI_DAILY_BUDGET=100
JOB_AI_WEEKLY_BUDGET=500

# From address for job-apply notifications (falls back to EMAIL_USER).
JOB_NOTIFY_FROM=

# ─── Social Publisher (LinkedIn + X posting) ─────────────────────────────────

# Content generation — OpenAI-compatible endpoint (e.g. zenmux / aihub).
CONTENT_AI_BASE_URL=
CONTENT_AI_API_KEY=
CONTENT_AI_MODEL=

# Image generation — separate OpenAI-compatible endpoint.
IMAGE_AI_BASE_URL=
IMAGE_AI_API_KEY=
IMAGE_AI_MODEL=
IMAGE_AI_SIZE=1024x1024

# LinkedIn Developer App — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/social/linkedin/callback

# X Developer App — https://developer.x.com (OAuth 2.0, user context)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:5000/api/social/x/callback

# Public base URL of this server (used to build OAuth redirect URIs when the
# dedicated LINKEDIN_REDIRECT_URI / X_REDIRECT_URI values are left empty).
SERVER_BASE_URL=http://localhost:5000

# AES-256-GCM key for encrypting stored social OAuth tokens (>= 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCIAL_CREDENTIALS_KEY=
